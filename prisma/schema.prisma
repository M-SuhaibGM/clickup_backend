// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // ← Back to default location
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  avatar    String?
  googleId  String?  @unique
  provider  String   @default("local")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspace relationships
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")

  // Task relationships
  assignedTasks Task[]     @relation("UserTasks")
  comments      Comment[]
  projects      Project[]  @relation("ProjectCreator")
  activities    Activity[]
}

// backend/prisma/schema.prisma
model Automation {
  id          String   @id @default(uuid())
  workspaceId String
  trigger     String   // "TASK_CREATED", "STATUS_DONE", "PRIORITY_URGENT"
  action      String   // "SEND_EMAIL", "ASSIGN_TO_ADMIN", "SEND_SLACK"
  actionValue String?  // Optional config (e.g., email address, admin userId)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  projects    Project[]
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  userId      String?
  activities  Activity[]
  automations Automation[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // "ADMIN" | "MEMBER"
  jobTitle    String?  @default("Fullstack Developer")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// backend/prisma/schema.prisma
model Activity {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  action      String // e.g., "created", "updated", "deleted"
  entityType  String // e.g., "project", "list", "task", "member"
  entityName  String // e.g., "Marketing Site"
  metadata    Json? // Optional: { from: "...", to: "..." }
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id])

  lists List[]
}

model List {
  id        String  @id @default(uuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Float   @default(0)

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("NORMAL")
  dueDate     DateTime?

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("UserTasks", fields: [assigneeId], references: [id])

  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")

  order       Float     @default(0)
  attachments String[]  @default([]) // ← ADD THIS
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
