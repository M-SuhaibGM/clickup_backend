// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client" // ← Back to default location
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  avatar    String?
  googleId  String?  @unique
  provider  String   @default("local")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspace relationships
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")

  // Task relationships
  assignedTasks Task[]     @relation("UserTasks")
  comments      Comment[]
  projects      Project[]  @relation("ProjectCreator")
  activities    Activity[]
  clips         Clip[]
  teamMemberships TeamMember[]
  channelReactions ChannelReaction[]
  timeEntries TimeEntry[]
  personalTasks PersonalTask[]

  channelMessages  ChannelMessage[]
  posts            Post[]
  sentMessages     DirectMessage[] @relation("DmSender")
  receivedMessages DirectMessage[] @relation("DmReceiver")
}

// backend/prisma/schema.prisma
model Automation {
  id          String   @id @default(uuid())
  workspaceId String
  trigger     String   // "TASK_CREATED", "STATUS_DONE", "PRIORITY_URGENT"
  action      String   // "SEND_EMAIL", "ASSIGN_TO_ADMIN", "SEND_SLACK"
  actionValue String?  // Optional config (e.g., email address, admin userId)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  spaces      Space[]
  teams       Team[]
  projects    Project[]
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  userId      String?
  activities  Activity[]
  automations Automation[]
  directMessages DirectMessage[]
  personalTasks PersonalTask[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER") // "ADMIN" | "MEMBER"
  jobTitle    String?  @default("Fullstack Developer")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])

  @@index([userId])
}

// backend/prisma/schema.prisma
model Activity {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  action      String // e.g., "created", "updated", "deleted"
  entityType  String // e.g., "project", "list", "task", "member"
  entityName  String // e.g., "Marketing Site"
  metadata    Json? // Optional: { from: "...", to: "..." }
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Workspace -> Space -> Project -> (1 Channel + many Lists) -> Tasks
model Space {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#6366f1")
  icon        String?  // key of a built-in icon; null = first letter of the name
  description String?
  order       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([workspaceId, order])
}

// Workspace -> Team -> Members (a team groups people, a space groups work)
model Team {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#6366f1")
  icon        String?  // key of a built-in icon; null = first letter of the name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members TeamMember[]

  @@index([workspaceId, createdAt])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Every project lives in exactly one space. Nullable ONLY so existing rows
  // survive the schema push; run `npm run backfill:spaces` once, after which
  // this can be made required. The API always sets it for new projects.
  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id])

  // Exactly one channel per project (projectId is @unique), named after the project.
  channel Channel?

  lists List[]

  @@index([spaceId])

  @@index([workspaceId, createdAt])
}

// One chat channel per project; its name always mirrors the project name.
model Channel {
  id        String   @id @default(uuid())
  name      String
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChannelMessage[]
  posts    Post[]
}

// A post published to a project's channel (announcement, update, …)
model Post {
  id        String   @id @default(uuid())
  channelId String
  authorId  String
  type      String   @default("ANNOUNCEMENT") // ANNOUNCEMENT | UPDATE | DISCUSSION | QUESTION
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions ChannelReaction[]

  @@index([channelId, createdAt])
  @@index([authorId])
}

model ChannelMessage {
  id        String   @id @default(uuid())
  channelId String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions ChannelReaction[]

  @@index([channelId, createdAt])
}

// An emoji reaction on a channel message OR a post (exactly one of messageId / postId is set)
model ChannelReaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  messageId String?
  postId    String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChannelMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  post    Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, emoji, messageId])
  @@unique([userId, emoji, postId])
  @@index([messageId])
  @@index([postId])
}

model List {
  id        String  @id @default(uuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Float   @default(0)

  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("NORMAL")
  dueDate     DateTime?
  startDate   DateTime?
  /** time estimate, in minutes */
  estimateMinutes Int?
  tags        String[]  @default([])

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("UserTasks", fields: [assigneeId], references: [id])

  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")

  order       Float     @default(0)
  attachments String[]  @default([]) // ← ADD THIS
  comments    Comment[]
  timeEntries TimeEntry[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listId, order])
  @@index([assigneeId])
  @@index([parentId])
}

// Time tracked on a task. A running timer has no endedAt; manual entries are stored as a start/end pair too.
model TimeEntry {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  manual    Boolean   @default(false)
  note      String?
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([userId, endedAt])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  /** set when the comment has been marked resolved */
  resolvedAt DateTime?

  @@index([taskId, createdAt])
  @@index([userId])
}

// A private to-do on the "My Tasks" page — not tied to any project or list, and only ever visible to its owner.
model PersonalTask {
  id          String   @id @default(uuid())
  title       String
  done        Boolean  @default(false)
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, done])
}


model Clip {
  id        String   @id @default(uuid())
  title     String
  url       String
  fileKey   String
  duration  Int?     // seconds
  size      Int?     // bytes
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}


// One-to-one chat message between two members of a workspace
model DirectMessage {
  id          String    @id @default(uuid())
  workspaceId String
  senderId    String
  receiverId  String
  text        String
  readAt      DateTime? // null = receiver hasn't read it yet
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender    User      @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User      @relation("DmReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([workspaceId, senderId, receiverId, createdAt])
  @@index([workspaceId, receiverId, readAt])
}
